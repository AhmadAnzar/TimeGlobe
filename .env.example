# Copy to .env (gitignored) and fill in. Never commit real values.

# Contact address put in the scraper User-Agent so site operators can reach us.
TIMEGLOBE_CONTACT=

# Neon Postgres connection string.
DATABASE_URL=

# Vercel deploy hook triggered after a successful ingest (phase 3 onwards).
VERCEL_DEPLOY_HOOK_URL=

# Throwaway database for the migration integration test (it works in a scratch schema).
# The test also needs TIMEGLOBE_RUN_DB_TESTS=1 in the shell, so a plain pytest never connects.
# Use a separate Neon branch, never dev or production.
TIMEGLOBE_TEST_DATABASE_URL=
