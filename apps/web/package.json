{
  "name": "timeglobe-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "data": "node scripts/copy-snapshot.mjs",
    "data:local": "node scripts/copy-snapshot.mjs --from-git origin/data",
    "data:dir": "node scripts/copy-snapshot.mjs --from-dir",
    "check:data": "node scripts/check-snapshot.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "npm run data && npm run check:data",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/check-bundle.mjs",
    "build:local": "npm run data:local && npm run check:data && npm run build --ignore-scripts",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3-array": "^3.2.5",
    "d3-axis": "^3.0.1",
    "d3-scale": "^4.0.3",
    "d3-scale-chromatic": "^3.1.1",
    "d3-selection": "^3.0.1",
    "d3-shape": "^3.2.1",
    "globe.gl": "^2.46.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
